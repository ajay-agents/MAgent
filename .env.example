# Copy to .env and fill in. Do NOT put comments on the same line as a value —
# they become part of the value.

# development | production. Production refuses to start with insecure defaults,
# disables /docs, and returns an error instead of a mock email when AI fails.
ENVIRONMENT=development

# AI providers, tried in order: OpenAI -> Gemini -> Groq. Leave unused ones empty.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Random string, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Signs unsubscribe links in sent emails. 32+ random chars, different from JWT_SECRET, and NEVER rotate it
# (old links would stop working). Generate the same way as JWT_SECRET.
LINK_SIGNING_SECRET=

# Encrypts stored Gmail App Passwords. Changing it makes saved credentials unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional: "Connect with Google" for sending through the Gmail API (see README).
# Without these, users connect Gmail with an App Password instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the Google OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/api/mailbox/google/callback
# Where the browser returns after Google's consent screen
FRONTEND_URL=http://localhost:5173

# System email for verification and password-reset links: any SMTP service (Gmail/Workspace,
# Amazon SES, Postmark, Brevo, ...). Required in production; in development the links are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MailFlow <no-reply@yourdomain.com>

# Max emails each user sends per rolling 24 hours (Gmail allows ~500 personal / ~2,000 Workspace)
DAILY_SEND_LIMIT=400

# Public https URL of this API. Unsubscribe links in sent emails point here, so recipients must be able to reach it
PUBLIC_API_URL=http://localhost:8000

# Shown on the "Upgrade to Pro" screen until online payments are added (leave empty to hide)
SUPPORT_EMAIL=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///./mailflow.db
LOG_LEVEL=INFO
